spike/out*/
data/

# Angulars byggcache
.angular/

# Lokal backupkatalog vid utveckling. Rotankrad — ett omönstrat `backup/` matchar
# även källkodskataloger som server/src/backup/, vilket tyst utelämnar dem ur git.
/backup/

# Maskinens egna inställningar, inte projektets.
.env
