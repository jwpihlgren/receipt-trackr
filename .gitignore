node_modules/
dist/
build/

# Kvittobilder är privata och hör aldrig hemma i versionshanteringen.
spike/samples/*
!spike/samples/.gitkeep
spike/out*/
data/

# Angulars byggcache
.angular/

# Lokal backupkatalog vid utveckling. Rotankrad — ett omönstrat `backup/` matchar
# även källkodskataloger som server/src/backup/, vilket tyst utelämnar dem ur git.
/backup/

# Maskinens egna inställningar, inte projektets.
.env

# OCR-modellerna hämtas vid bygget av scripts/hamta-modeller.mjs. 36 MB binärer som
# går att hämta igen hör inte hemma i historiken — arkivet ska bära kvitton.
/web/public/modeller/
